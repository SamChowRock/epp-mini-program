<view class="page">
  <view class="page-header"><text class="kicker">EPP</text><text class="title">本人星图</text><text class="lede muted">本地 Fake · 仅已采纳表达 · 关键词搜索，不调用 AI</text></view>
  <text wx:if="{{error}}" class="notice error" role="alert">{{error}}</text>
  <view wx:if="{{!ready}}" class="card">
    <text class="section-title">查看自己的表达</text><text class="lede">阅读隐私后，明确同意并登录。</text>
    <button bindtap="login" disabled="{{busy}}">同意说明并登录（Fake）</button>
    <button class="button-quiet" bindtap="privacy">阅读隐私说明</button>
  </view>
  <block wx:else>
    <text wx:if="{{!queryEnabled}}" class="notice">查询入口暂未启用</text>
    <block wx:else>
      <view class="card"><text class="label">搜索表达（最多 200 字）</text>
        <input aria-label="搜索表达" placeholder="中文或英文关键词" value="{{q}}" bindinput="input" maxlength="-1" confirm-type="search" bindconfirm="search"/>
        <button bindtap="search" disabled="{{busy}}">搜索 / 刷新首屏</button>
        <button wx:if="{{q}}" class="button-quiet" bindtap="clearSearch" disabled="{{busy}}">清空关键词</button>
      </view>
      <text wx:if="{{busy}}" class="notice">正在读取星图</text>
      <text class="section-heading">当前结果：{{submittedQ || '全部已采纳表达'}}</text>
      <button class="expression-card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><text class="expression-name">{{item.canonicalForm}}</text><text class="muted">{{item.meaningZh}}</text><text class="card-action">查看详情</text></button>
      <text wx:if="{{!rows.length && !busy}}" class="card muted">{{submittedQ ? '没有找到匹配表达，请清空关键词后重试。' : '还没有已采纳表达。请在 Agent 中使用 EPP 记录并确认想学的表达，再回来查看。'}}</text>
      <button wx:if="{{nextCursor}}" class="button-secondary" bindtap="more" disabled="{{busy}}">加载更多</button>
      <text wx:if="{{rows.length && !nextCursor && !busy}}" class="footnote">已显示全部表达</text>
      <button class="button-quiet" bindtap="copySite">复制网站地址</button>
    </block>
  </block>
</view>
