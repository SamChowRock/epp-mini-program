<view class="page">
  <view class="page-header"><text class="kicker">EPP</text><text class="title">隐私说明</text></view>
  <text wx:if="{{error}}" class="notice error" role="alert">{{error}}</text>
  <view wx:if="{{privacy}}" class="card"><text class="badge">版本 {{privacy.version}}</text><text selectable>{{privacy.text}}</text>
    <view class="field"><text class="label">支持联系</text><text selectable>{{privacy.supportContact}}</text></view>
    <view class="field"><text class="label">账号与数据处置</text><text wx:if="{{privacy.accountActionsUrl}}" selectable>{{privacy.accountActionsUrl}}</text><text wx:else class="muted">账号与数据处置自助入口尚未提供，请联系上述支持。此版本不提供注销功能。</text></view>
    <button class="button-secondary" bindtap="copy">复制{{privacy.accountActionsUrl ? '处置地址' : '支持联系方式'}}</button>
  </view>
</view>
